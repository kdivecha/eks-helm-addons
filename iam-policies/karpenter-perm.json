{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AllowKarpenterEC2Discovery",
      "Effect": "Allow",
      "Action": [
        "ec2:DescribeAvailabilityZones", "ec2:DescribeImages", "ec2:DescribeInstances", "ec2:DescribeInstanceTypes",
        "ec2:DescribeInstanceTypeOfferings", "ec2:DescribeLaunchTemplates", "ec2:DescribeSecurityGroups",
        "ec2:DescribeSpotPriceHistory", "ec2:DescribeSubnets", "ec2:DescribeTags", "ec2:DescribeVolumes",
        "ec2:DescribeCapacityReservations", "ec2:DescribeScheduledInstanceAvailability", "ssm:GetParameter",
        "pricing:GetProducts", "eks:DescribeCluster", "arc-zonal-shift:ListAutoshifts"
      ],
      "Resource": "*"
    },
    {
      "Sid": "AllowKarpenterNodeLifecycle",
      "Effect": "Allow",
      "Action": [
        "ec2:CreateFleet", "ec2:CreateLaunchTemplate", "ec2:CreateTags", "ec2:DeleteLaunchTemplate",
        "ec2:DeleteTags", "ec2:RunInstances", "ec2:TerminateInstances"
      ],
      "Resource": "*"
    },
    {
      "Sid": "AllowKarpenterInstanceProfileLifecycle",
      "Effect": "Allow",
      "Action": [
        "iam:AddRoleToInstanceProfile", "iam:CreateInstanceProfile", "iam:DeleteInstanceProfile",
        "iam:GetInstanceProfile", "iam:RemoveRoleFromInstanceProfile", "iam:TagInstanceProfile"
      ],
      "Resource": "arn:REPLACE_WITH_AWS_PARTITION:iam::123456789012:instance-profile/*"
    },
    {
      "Sid": "AllowKarpenterToPassConfiguredNodeRole",
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": "arn:REPLACE_WITH_AWS_PARTITION:iam::123456789012:role/REPLACE_WITH_KARPENTER_NODE_ROLE"
    }
  ]
}
