{
  "Version": "2012-10-17",
  "Statement": [{
    "Sid": "AllowLokiObjectStorage",
    "Effect": "Allow",
    "Action": ["s3:ListBucket", "s3:GetObject", "s3:PutObject", "s3:DeleteObject"],
    "Resource": [
      "arn:aws-us-gov:s3:::REPLACE_WITH_LOKI_S3_BUCKET",
      "arn:aws-us-gov:s3:::REPLACE_WITH_LOKI_S3_BUCKET/*"
    ]
  }]
}
